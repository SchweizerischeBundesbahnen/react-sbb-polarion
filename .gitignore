node_modules/
dist/

# IDE / editor
.idea/
.vscode/

# Vitest browser-mode attachments (transient)
.vitest-attachments/

# Committed expected screenshots live in test/expected/ (one PNG per screenshot, no platform suffix).
# They are always generated on Linux in the pinned Playwright Docker image - the `test:update` script
# refuses to run off Linux (see package.json / test/README.md) so a Windows/macOS dev cannot overwrite
# a committed reference with mismatching pixels. So test/expected/ IS tracked.

# Transient visual-regression artifacts (mismatch diffs + auto failure screenshots).
test/__diff__/
test/__screenshots__/

# Coverage reports (generated by npm run test:coverage[:docker]).
coverage/
