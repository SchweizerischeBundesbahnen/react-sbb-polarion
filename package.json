{
  "name": "@sbb-polarion/react-sbb-polarion",
  "version": "2.5.1",
  "description": "Shared React UI components for SBB Polarion extension apps.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SchweizerischeBundesbahnen/react-sbb-polarion.git"
  },
  "type": "module",
  "files": [
    "dist",
    "eslint"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./breadcrumb-bridge.js": "./dist/breadcrumb-bridge.js",
    "./dle-toolbar-starter.js": "./dist/dle-toolbar-starter.js",
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing.js"
    },
    "./eslint-config": {
      "types": "./eslint/index.d.ts",
      "import": "./eslint/index.js"
    }
  },
  "style": "./dist/style.css",
  "scripts": {
    "build": "vite build && vite build --config vite.bridge.config.ts && vite build --config vite.toolbar.config.ts && vite build --config vite.testing.config.ts && tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update": "node -e \"process.platform==='linux'||(console.error('\\n[test:update] Reference screenshots must be generated on Linux (inside the pinned Playwright Docker image) so they match CI. See test/README.md.\\n'),process.exit(1))\" && vitest run --update",
    "test:docker": "node scripts/docker-test.mjs test",
    "test:update:docker": "node scripts/docker-test.mjs test:update",
    "test:coverage": "vitest run --coverage --exclude \"**/*.visual.test.tsx\"",
    "test:coverage:full": "vitest run --coverage",
    "test:coverage:docker": "node scripts/docker-test.mjs test:coverage:full",
    "format": "prettier --write \"**/*.{ts,tsx,css,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,mjs}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7",
    "axe-core": "^4.10.0",
    "eslint": ">=9.22.0",
    "@eslint/js": ">=9.0.0",
    "typescript-eslint": "^8.0.0",
    "eslint-plugin-react-hooks": ">=5.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-config-prettier": ">=9.0.0",
    "globals": ">=15.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "5.0.1",
    "@vitest/coverage-istanbul": "5.0.1",
    "axe-core": "4.13.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "vitest-browser-react": "2.3.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11"
  },
  "allowScripts": {
    "esbuild": true
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "refractor": "^5.0.0"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  },
  "peerDependenciesMeta": {
    "axe-core": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "@eslint/js": {
      "optional": true
    },
    "typescript-eslint": {
      "optional": true
    },
    "eslint-plugin-react-hooks": {
      "optional": true
    },
    "eslint-plugin-jsx-a11y": {
      "optional": true
    },
    "eslint-config-prettier": {
      "optional": true
    },
    "globals": {
      "optional": true
    }
  }
}
