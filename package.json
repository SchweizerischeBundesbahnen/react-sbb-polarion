{
  "name": "@grigoriev/react-sbb-polarion",
  "version": "0.2.0",
  "description": "Shared React UI components for SBB Polarion extension apps.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grigoriev/react-sbb-polarion.git"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./breadcrumb-bridge.js": "./dist/breadcrumb-bridge.js"
  },
  "style": "./dist/style.css",
  "scripts": {
    "build": "vite build && vite build --config vite.bridge.config.ts && tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update": "node -e \"process.platform==='linux'||(console.error('\\n[test:update] Reference screenshots must be generated on Linux (inside the pinned Playwright Docker image) so they match CI. See test/README.md.\\n'),process.exit(1))\" && vitest run --update",
    "test:docker": "node scripts/docker-test.mjs test",
    "test:update:docker": "node scripts/docker-test.mjs test:update",
    "test:coverage": "vitest run --coverage --exclude \"**/*.visual.test.tsx\"",
    "test:coverage:full": "vitest run --coverage",
    "test:coverage:docker": "node scripts/docker-test.mjs test:coverage:full",
    "format": "prettier --write \"**/*.{ts,tsx,css,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,mjs}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-istanbul": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "playwright": "1.62.0",
    "prettier": "^3.9.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.7",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "8.1.5",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11"
  },
  "allowScripts": {
    "esbuild": true
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "refractor": "^5.0.0"
  }
}
